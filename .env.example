# Reserved for future production integrations. The mocked pipeline needs no secrets.
FFW_MODE=mock
FFW_ARCHIVE_DIR=archive
FFW_STATE_FILE=state/episodes.json
OPENAI_API_KEY=
FFW_RSS_URL=https://feeds.soundcloud.com/users/soundcloud:users:201003125/sounds.rss
FFW_MODE=live
FFW_FEED_URL=https://feeds.soundcloud.com/users/soundcloud:users:201003125/sounds.rss
FFW_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
FFW_TRANSCRIPTION_FALLBACK_MODEL=
FFW_TRANSCRIPTION_PROVIDER_FALLBACK=openai
FFW_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
FFW_RETAIN_TRANSCRIPTS=false
FFW_TARGETED_VERIFICATION_ENABLED=true
FFW_TARGETED_VERIFICATION_MAX_PICKS=2
FFW_GEMINI_TRANSIENT_RETRIES=2
FFW_GEMINI_RETRY_DELAY_SECONDS=30
FFW_EXTRACTION_MODEL=gpt-5.6-luna
FFW_CARD_GLOSSARY=
FFW_MAX_AUDIO_BYTES=250000000
FFW_MAX_EPISODE_ATTEMPTS=3
FFW_RETRY_COOLDOWN_HOURS=6
FFW_AUTOMATIC_MAX_EPISODE_AGE_DAYS=365
FFW_CARD_RESOLUTION_ENABLED=true
FFW_CARD_RESOLUTION_BATCH_SIZE=25
FFW_CARD_RESOLUTION_TIMEOUT_SECONDS=15
# Optional local CA for an HTTPS-inspecting proxy. Falls back to NODE_EXTRA_CA_CERTS when set.
FFW_CA_BUNDLE=
OPENAI_API_KEY=
